<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: ink ground + the Lifeline mark; the Compose SplashScreen continues it. -->
    <style name="Theme.RodinRescue" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#ECEFF2</item>
        <item name="android:statusBarColor">#ECEFF2</item>
        <item name="android:navigationBarColor">#ECEFF2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">#0B0D10</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_fg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0B0D10</item>
    </style>
</resources>
