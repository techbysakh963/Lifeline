<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the developer's adb run a built-in CLI's connection test (DebugSessionTest). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- DUMP: only the adb shell (or the system) can send this; other apps can't spend the user's plan. -->
        <receiver android:name=".DebugSessionTest" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.rodinrescue.DEBUG_SESSION_TEST" /></intent-filter>
        </receiver>
    </application>
</manifest>
